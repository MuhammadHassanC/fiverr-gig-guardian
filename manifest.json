{
  "manifest_version": 3,
  "name": "Fiverr Gig Guardian — Title Policy & Community Standards Shield",
  "version": "2.3.0",
  "description": "Real-time regulatory scanner for Fiverr gig titles. Detects prohibited words, academic work, off-platform triggers, and account strike risks.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.fiverr.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Fiverr Gig Guardian",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.fiverr.com/*"
      ],
      "js": [
        "rules/policy-database.js",
        "core/risk-engine.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
